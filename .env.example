# 데이터베이스 (Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drgl?schema=public"
# 마이그레이션용 직결 커넥션. 커넥션 풀러(Neon 등)를 안 쓰면 DATABASE_URL 과 같은 값으로 두세요.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/drgl?schema=public"

# 어드민 세션 쿠키 서명 키 (운영에서는 반드시 교체)
AUTH_SECRET="change-me-to-a-long-random-string"

# 시드로 만들 최초 운영자 계정
SEED_ADMIN_EMAIL="admin@drgl.local"
SEED_ADMIN_PASSWORD="drgl-admin-1234"

# 이미지 스토리지
#   local — 로컬 uploads 디렉터리에 저장 (기본, 직접 서버를 돌릴 때)
#   db    — Postgres 에 저장 (Vercel 등 디스크에 못 쓰는 배포 환경. 미지정 시 자동 선택)
#   s3    — S3 호환 버킷
STORAGE_DRIVER="local"
# STORAGE_DRIVER=local 일 때 업로드 파일이 저장될 경로 (기본값: ./uploads)
UPLOAD_DIR="./uploads"

# STORAGE_DRIVER=s3 일 때만 필요
S3_ENDPOINT=""
S3_REGION="ap-northeast-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# 구글 애널리틱스 4 측정 ID (예: G-XXXXXXXXXX)
#   비워두면 GA 스크립트를 아예 넣지 않는다 → 쿠키도 생기지 않고, 심어둔 이벤트는 조용히 무시된다.
NEXT_PUBLIC_GA_ID=""

# 한줄평 rate limit (기본: 10분에 5건)
COMMENT_RATE_LIMIT_MAX="5"
COMMENT_RATE_LIMIT_WINDOW_MINUTES="10"
