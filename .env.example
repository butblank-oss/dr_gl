# 데이터베이스 (Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drgl?schema=public"

# 어드민 세션 쿠키 서명 키 (운영에서는 반드시 교체)
AUTH_SECRET="change-me-to-a-long-random-string"

# 시드로 만들 최초 운영자 계정
SEED_ADMIN_EMAIL="admin@drgl.local"
SEED_ADMIN_PASSWORD="drgl-admin-1234"

# 이미지 스토리지: "local" (로컬 uploads 디렉터리 + /media 라우트) 또는 "s3"
STORAGE_DRIVER="local"
# STORAGE_DRIVER=local 일 때 업로드 파일이 저장될 경로 (기본값: ./uploads)
UPLOAD_DIR="./uploads"

# STORAGE_DRIVER=s3 일 때만 필요
S3_ENDPOINT=""
S3_REGION="ap-northeast-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# 한줄평 rate limit (기본: 10분에 5건)
COMMENT_RATE_LIMIT_MAX="5"
COMMENT_RATE_LIMIT_WINDOW_MINUTES="10"
